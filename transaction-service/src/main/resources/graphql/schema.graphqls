type Query {
    transactions: [Transaction]
    transactionsByAccount(accountId: ID!): [Transaction]
}

type Mutation {
    executeTransaction(input: TransactionInput!): Transaction
}

type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    createdAt: String
}

input TransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
}