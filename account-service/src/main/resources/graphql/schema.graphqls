type Query {
    accounts: [Account]
    accountById(id: ID!): Account
}

type Mutation {
    createAccount(accountInput: AccountInput!): Account
}

type Account {
    id: ID!
    customerReference: String
    status: String
    currency: String
    balance: Float
}

input AccountInput {
    customerReference: String!
    currency: String!
    balance: Float!
}